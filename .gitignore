# ===== Python 字节码 / 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== 虚拟环境（可重建，不提交） =====
.venv/
venv/
env/

# ===== PyInstaller / 构建产物 =====
build/
# 打包出的 .app 是二进制产物，通常不入库；若你想直接分发 .app，把这行删掉即可
dist/
*.spec
*.manifest
# PyInstaller 缓存目录（build.sh 用 PYINSTALLER_CONFIG_DIR 重定向到项目内）
.pyinstaller-cache/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 临时 / 回收目录 =====
_trash*/
*.bak
